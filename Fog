	for _, def in ipairs(TAB_DEFS) do
		local parts = tabParts[def.id]
		local on = def.id == currentTabId
		parts.label.TextColor3 = on and PALETTE.Deep or PALETTE.TextMuted
		parts.emoji.TextTransparency = on and 0 or 0.4
	end
