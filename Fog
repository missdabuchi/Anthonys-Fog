-- ============================================================================
-- Theme bindings
-- ============================================================================
-- Anywhere a color is given as a string (e.g. BackgroundColor3 = "Dark") it is
-- looked up in PALETTE and re-colored automatically when the theme changes.

local bindings = {} -- { instance, property, paletteKey }
local gradientBindings = {} -- { gradient, colorOrKeyA, colorOrKeyB }
local themeHooks = {} -- extra functions that run when the theme changes

local function resolve(colorOrKey)
	if type(colorOrKey) == "string" then
		return PALETTE[colorOrKey]
	end
	return colorOrKey
end

local function bind(inst, prop, colorOrKey)
	if type(colorOrKey) == "string" then
		table.insert(bindings, { inst, prop, colorOrKey })
	end
	inst[prop] = resolve(colorOrKey)
end

local function onTheme(fn)
	table.insert(themeHooks, fn)
	fn()
end

-- ============================================================================
-- Small helpers
-- ============================================================================

local connections = {} -- only global (UserInputService / RunService) connections need manual cleanup

local function track(connection)
	table.insert(connections, connection)
	return connection
end

-- Re-apply the user's settings every frame (runs last before rendering)
track(RunService.RenderStepped:Connect(function()
	for prop, value in pairs(forced) do
		if Lighting[prop] ~= value then
			Lighting[prop] = value
		end
	end
end))

local menuTexts = {} -- every menu text that uses FONT (the font changer restyles these)

local function create(className, props)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			if type(value) == "string" and string.sub(key, -6) == "Color3" then
				bind(inst, key, value) -- themed color
			else
				inst[key] = value
			end
		end
	end
	if props.Font == FONT then
		table.insert(menuTexts, inst)
	end
	inst.Parent = props.Parent -- parent last = fewer property-change events
	return inst
end

local function round(inst, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = inst
	return corner
end

local function stroke(inst, color, thickness)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- outline the frame/button, not its text
	bind(s, "Color", color)
	s.Thickness = thickness
	s.Parent = inst
	return s
end

local function padding(inst, left, right, top, bottom)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or top or 0),
		Parent = inst,
	})
end

-- NOTE: a UIGradient also tints TEXT of the object it sits on, so gradients are only
-- ever put on text-free frames (buttons use a gradient "face" with a transparent button on top).
local function gradient(parent, colorA, colorB, rotation)
	local g = Instance.new("UIGradient")
	g.Rotation = rotation or 0
	g.Color = ColorSequence.new(resolve(colorA), resolve(colorB))
	g.Parent = parent
	table.insert(gradientBindings, { g, colorA, colorB })
	return g
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function playSound(soundId, volume, speed)
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = speed or 1
	sound.Parent = SoundService
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	sound:Play()
	task.delay(6, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- Squishy hover / press feedback. Events come from `button`, the scale is applied to `target`.
local function addHover(button, hoverScale, target)
	hoverScale = hoverScale or 1.08
	local scale = create("UIScale", { Parent = target or button })
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local function to(value)
		TweenService:Create(scale, info, { Scale = value }):Play()
	end
	button.MouseEnter:Connect(function()
		to(hoverScale)
	end)
	button.MouseLeave:Connect(function()
		to(1)
	end)
	button.MouseButton1Down:Connect(function()
		to(0.94)
	end)
	button.MouseButton1Up:Connect(function()
		to(hoverScale)
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			to(1)
		end
	end)
end

