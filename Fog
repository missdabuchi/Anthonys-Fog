	stroke(bar, "Soft", 1)
	local colorGradient = create("UIGradient", { Parent = bar })

	local knob = create("Frame", {
		Size = UDim2.fromOffset(20, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = hit,
	})
	round(knob, FULL)
	stroke(knob, "Dark", 3)

	currentPage = page
	bindDrag(hit, function(input)
		onDrag(math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
	end)

	return colorGradient, function(ratio)
		knob.Position = UDim2.new(ratio, 0, 0.5, 0)
	end
