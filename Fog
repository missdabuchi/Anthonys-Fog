-- Icon loader tries these in order until one loads
local ICON_CANDIDATES = (USE_IMAGE_ICON and ICON_ID) and {
	"rbxthumb://type=Asset&id=" .. ICON_ID .. "&w=150&h=150",
	"rbxassetid://" .. ICON_ID,
	"http://www.roblox.com/asset/?id=" .. ICON_ID,
} or {}

local function loadIcon(label, onDone)
	task.spawn(function()
		for _, candidate in ipairs(ICON_CANDIDATES) do
			label.Image = candidate
			local success = false
			pcall(function()
				ContentProvider:PreloadAsync({ label }, function(_, status)
					if status == Enum.AssetFetchStatus.Success then
						success = true
					end
				end)
			end)
			if success or label.IsLoaded then
				if onDone then
					onDone(true)
				end
				return
			end
		end
		label.Visible = false
		if onDone then
			onDone(false)
		end
	end)
end

