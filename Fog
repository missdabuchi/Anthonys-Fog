		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = switchBtn,
	})
	round(knob, FULL)

	local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local function render(animate)
		local colorGoal = state and PALETTE.Dark or PALETTE.SwitchOff
		local posGoal = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
		if animate then
			TweenService:Create(switchBtn, tweenInfo, { BackgroundColor3 = colorGoal }):Play()
			TweenService:Create(knob, tweenInfo, { Position = posGoal }):Play()
		else
			switchBtn.BackgroundColor3 = colorGoal
			knob.Position = posGoal
		end
	end
	render(false)
	onTheme(function()
		render(false) -- re-color the switch when the theme changes
	end)

	switchBtn.MouseButton1Click:Connect(function()
		state = not state
		render(true)
		playSound(CLICK_SOUND_ID, 0.3, state and 1.4 or 1.1)
		callback(state)
	end)

	return function(newState)
		state = newState
		render(true)
	end
end

local function formatClock(value)
	local total = math.floor(value * 60 + 0.5)
	return string.format("%02d:%02d", math.floor(total / 60), total % 60)
end

