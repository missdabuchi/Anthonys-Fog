-- ============================================================================
-- Draggable (mouse + touch, clamped to the screen, click-vs-drag aware)
-- ============================================================================

local function makeDraggable(guiObject, handle)
	handle = handle or guiObject
	local state = { Moved = false }
	local dragging = false
	local dragStart, startPos

	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			state.Moved = false
			dragStart = input.Position
			startPos = guiObject.AbsolutePosition
		end
	end)

	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 5 then
				state.Moved = true
			end
			if state.Moved then
				local screenSize = screenGui.AbsoluteSize
				local size = guiObject.AbsoluteSize
				local x = math.clamp(startPos.X + delta.X, 0, math.max(0, screenSize.X - size.X))
				local y = math.clamp(startPos.Y + delta.Y, 0, math.max(0, screenSize.Y - size.Y))
				guiObject.Position = UDim2.fromOffset(x, y)
			end
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end))

	return state
end

-- ============================================================================
-- Toast notifications (slide in from the top, little chime)
-- ============================================================================

local activeFace -- the Font object the menu currently uses (nil = built-in look)
local activeToast

local function notify(text, icon, silent, duration)
	if activeToast then
		activeToast:Destroy()
		activeToast = nil
	end

	local toast = create("Frame", {
		Name = "Toast",
		Size = UDim2.fromOffset(290, 50),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -70),
		BackgroundColor3 = PALETTE.CardBg,
		BorderSizePixel = 0,
		ZIndex = 100,
		Parent = screenGui,
	})
	activeToast = toast
	round(toast, UDim.new(0, 16))
	local toastStroke = Instance.new("UIStroke")
	toastStroke.Color = PALETTE.Dark
	toastStroke.Thickness = 2.5
	toastStroke.Parent = toast

	local badge = create("Frame", {
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.new(0, 9, 0.5, -17),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 101,
		Parent = toast,
	})
	round(badge, FULL)
	local badgeGradient = Instance.new("UIGradient")
	badgeGradient.Rotation = 90
	badgeGradient.Color = ColorSequence.new(PALETTE.Accent, PALETTE.Dark)
	badgeGradient.Parent = badge

	create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = icon or "✨",
		TextSize = 18,
		ZIndex = 102,
		Parent = badge,
	})

	local label = create("TextLabel", {
		Size = UDim2.new(1, -62, 1, 0),
		Position = UDim2.new(0, 52, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = PALETTE.TextDark,
		TextSize = 15,
		Font = Enum.Font.GothamBold, -- (not FONT, so it isn't tracked) restyled right below
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 101,
		Parent = toast,
	})
	if activeFace then
		label.FontFace = activeFace
	end

	if not silent then
		playSound(NOTIFY_SOUND_ID, 0.4, 1)
	end

	TweenService:Create(
		toast,
		TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0.5, 0, 0, 18) }
	):Play()

	task.delay(duration or 3.2, function()
		if activeToast ~= toast or not toast.Parent then
			return
		end
		local out = TweenService:Create(
			toast,
			TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = UDim2.new(0.5, 0, 0, -70) }
		)
		out:Play()
		out.Completed:Wait()
		if activeToast == toast then
			activeToast = nil
		end
		toast:Destroy()
	end)
end

