	local state = initialState
	local switchBtn = create("TextButton", {
		Size = UDim2.fromOffset(48, 26),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		BackgroundColor3 = PALETTE.SwitchOff,
		Text = "",
		AutoButtonColor = false,
		Parent = card,
